//
// String Table
//

STRINGTABLE
BEGIN
    IDS_PLUGINNAME              "Google Drive"
    IDS_ABOUT                   "About Google Drive Plugin"
    IDS_PLUGIN_DESCRIPTION      "Google Drive Filesystem Plugin for Open Salamander"
    IDS_PLUGIN_HOME             "https://github.com/manison/OpenSalamander"
    IDS_PLUGIN_BUGREP           "https://github.com/manison/OpenSalamander/issues"
    IDS_PLUGIN_EMAIL            "filip.novak@gmail.com"
    IDS_CFG_ALREADY_OPENED      "Configuration dialog is already open."
    IDS_CFG_TITLE               "Google Drive Configuration"
    IDS_REQUIRE_SAL500          "This plugin requires Open Salamander 5.0 or later."

    IDS_MENU_CONNECT            "&Open Google Drive\tAlt+F1/F2"
    IDS_MENU_DISCONNECT         "&Disconnect / Sign Out"
    IDS_MENU_REFRESH            "&Refresh Google Drive\tCtrl+R"
    IDS_MENU_CONFIG             "&Configuration..."
    IDS_MENU_ABOUT              "&About..."
    IDS_MENU_CALC_SIZE          "&Calculate Folder Size..."

    IDS_STATUS_CONNECTING       "Connecting to Google Drive..."
    IDS_STATUS_DOWNLOADING      "Downloading from Google Drive..."
    IDS_STATUS_AUTH_REQUIRED    "Sign-in required to access Google Drive."
    IDS_STATUS_AUTH_SUCCESS     "Successfully signed in to Google Drive!"
    IDS_STATUS_AUTH_FAILED      "Google Drive authentication failed."
    IDS_AUTH_PROMPT_MSG         "To access Google Drive, please sign in using your web browser."
    IDS_AUTH_WAITING_BROWSER    "Waiting for browser authentication response..."
    IDS_ERR_NETWORK             "Network error communicating with Google Drive."
    IDS_ERR_HTTP                "Google Drive HTTP error: %d"
    IDS_ERR_AUTH_CANCELLED      "Authentication was cancelled."
    IDS_ERR_PATH_NOT_FOUND      "Google Drive path not found: %s"
    IDS_DOWNLOAD_PROGRESS_FMT   "Downloading %s (%s / %s)..."
    IDS_CONFIRM_DISCONNECT      "Are you sure you want to disconnect and remove saved credentials?"
    IDS_LOGGED_IN_AS            "Signed in as: %s"
    IDS_NOT_LOGGED_IN           "Not signed in"
    IDS_MY_DRIVE                "My Drive"
    IDS_SHARED_DRIVES           "Shared Drives"
    IDS_SHARED_WITH_ME          "Shared with me"
    IDS_EXPORT_DOCX             "Exporting Google Doc to Word document (.docx)..."
    IDS_EXPORT_XLSX             "Exporting Google Sheet to Excel spreadsheet (.xlsx)..."
    IDS_EXPORT_PPTX             "Exporting Google Slides to PowerPoint (.pptx)..."
    IDS_EXPORT_PDF              "Exporting to PDF document (.pdf)..."
    IDS_ERR_NO_CLIENT_ID        "Google OAuth Client ID is not configured.\n\nPlease open Plugins -> Google Drive -> Configuration and enter your OAuth Client ID and Client Secret from Google Cloud Console."
    IDS_CALC_TITLE              "Google Drive Folder Size"
    IDS_CALC_RESULT_FMT         "Item: %s\n\nSubfolders: %d\nFiles: %d\n\nTotal size: %s (%s bytes)"
    IDS_CALC_CANCELLED_FMT      "Calculation was cancelled by user.\n\nItem: %s\n\nSubfolders found: %d\nFiles found: %d\n\nScanned size: %s (%s bytes)"
    IDS_ERR_CANNOT_CREATE_DIR_ROOT           "Cannot create folder in the root directory. Please select 'My Drive' or a specific folder first."
    IDS_ERR_CANNOT_CREATE_DIR_SHARED_WITH_ME "Cannot create new folders inside 'Shared with me'."
    IDS_ERR_CANNOT_CREATE_DIR_SHARED_DRIVES  "Cannot create folders directly in 'Shared Drives'. Create them inside a specific shared drive."
    IDS_ERR_CANNOT_RENAME_ROOT               "Cannot rename virtual or root folders."
    IDS_ERR_CANNOT_DELETE_ROOT               "Cannot delete virtual or root folders."
    IDS_CONFIRM_DELETE_TRASH_SINGLE          "Move '%s' to Google Drive Trash?"
    IDS_CONFIRM_DELETE_TRASH_MULTI           "Move %d selected items to Google Drive Trash?"
    IDS_CONFIRM_DELETE_PERM_SINGLE           "Permanently delete '%s' from Google Drive?\n\nWarning: This operation cannot be undone!"
    IDS_CONFIRM_DELETE_PERM_MULTI            "Permanently delete %d selected items from Google Drive?\n\nWarning: This operation cannot be undone!"
    IDS_UPLOAD_PROGRESS_FMT                  "Uploading %s (%s / %s)..."
    IDS_STATUS_UPLOADING                     "Uploading to Google Drive..."
    IDS_ERR_CANNOT_UPLOAD_ROOT               "Cannot upload files directly to the root view. Please open 'My Drive' or a specific folder first."
END

