/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_CFGPAGEGENERAL DIALOGEX 66, 53, 250, 180
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Účty a obecné"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Google účty",IDC_STATIC_1,4,4,242,76
    LTEXT           "Aktivní účet:",IDC_STATIC_2,12,18,55,8
    COMBOBOX        IDC_CFG_ACCOUNTS_COMBO,70,16,166,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Přidat účet...",IDC_CFG_ACCOUNT_ADD_BTN,12,34,68,14
    PUSHBUTTON      "&Aktivovat",IDC_CFG_ACCOUNT_SWITCH_BTN,84,34,68,14
    PUSHBUTTON      "&Odebrat",IDC_CFG_ACCOUNT_REMOVE_BTN,156,34,68,14
    CONTROL         "&Zobrazovat Sdílené disky (Team Drives)",IDC_CFG_USE_SHARED_DRIVES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,58,220,10

    GROUPBOX        "Vlastní OAuth 2.0 Client",IDC_STATIC_3,4,84,242,92
    LTEXT           "OAuth &Client ID:",IDC_STATIC_4,12,96,80,8
    EDITTEXT        IDC_CFG_CLIENTID,12,107,224,14,ES_AUTOHSCROLL
    LTEXT           "OAuth Client &Secret:",IDC_STATIC_5,12,124,80,8
    EDITTEXT        IDC_CFG_CLIENTSECRET,12,135,224,14,ES_AUTOHSCROLL
    LTEXT           "Poznámka: Pro přístup zadejte klíče typu Desktop App z Google Cloud Console.",IDC_STATIC_6,12,153,224,18
END

IDD_CFGPAGECACHE DIALOGEX 66, 53, 250, 180
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Mezipaměť a synchronizace"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Mezipaměť metadat",IDC_STATIC_1,4,4,242,100
    CONTROL         "&Povolit trvalou mezipaměť metadat na disku",IDC_CFG_CACHE_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,18,220,10
    LTEXT           "Frekvence kontroly změn na disku (TTL):",IDC_STATIC_2,12,36,220,8
    COMBOBOX        IDC_CFG_CACHE_INTERVAL_COMBO,12,48,224,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Stav mezipaměti: Připraveno (Odděleno pro každý účet)",IDC_CFG_CACHE_STATUS,12,68,220,8
    PUSHBUTTON      "&Vymazat mezipaměť aktivního účtu",IDC_CFG_CACHE_CLEAR_BTN,12,82,150,14

    GROUPBOX        "Informace",IDC_STATIC_3,4,108,242,68
    LTEXT           "Inteligentní mezipaměť výrazně zrychluje procházení složek.\nZměny na Google Disku se zjišťují přes Changes API bez nutnosti znovu stahovat celé složky.\n\nKaždý přihlášený účet má svůj vlastní izolovaný soubor mezipaměti v profilu.",IDC_STATIC_4,12,120,224,50
END

IDD_AUTH_PROGRESS DIALOGEX 0, 0, 230, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Přihlášení ke Google Disku"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Dokončete prosím přihlášení ve svém webovém prohlížeči...",IDC_AUTH_BROWSER_MSG,15,15,200,20
    CONTROL         "",IDC_AUTH_PROGRESS_BAR,"msctls_progress32",WS_BORDER,15,40,200,12
    LTEXT           "Čekám na autorizaci...",IDC_AUTH_STATUS_LABEL,15,58,200,8
    PUSHBUTTON      "Zrušit",IDCANCEL,85,72,60,14
END

IDD_CALC_SIZE_PROGRESS DIALOGEX 0, 0, 240, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Výpočet velikosti složky"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Prohledávám:",IDC_STATIC_1,15,12,50,8
    LTEXT           "",IDC_CALC_CURRENT_FOLDER,70,12,155,8,SS_PATHELLIPSIS
    LTEXT           "Podsložky:",IDC_STATIC_2,15,26,50,8
    LTEXT           "0",IDC_CALC_DIRS_COUNT,70,26,155,8
    LTEXT           "Soubory:",IDC_STATIC_3,15,40,50,8
    LTEXT           "0",IDC_CALC_FILES_COUNT,70,40,155,8
    LTEXT           "Celková velikost:",IDC_STATIC_4,15,54,55,8
    LTEXT           "0 B",IDC_CALC_TOTAL_SIZE,70,54,155,8
    CONTROL         "",IDC_CALC_PROGRESS_BAR,"msctls_progress32",WS_BORDER,15,68,210,12
    PUSHBUTTON      "Zrušit",IDCANCEL,90,88,60,14
END

